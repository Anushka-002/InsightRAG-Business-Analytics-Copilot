# InsightRAG Configuration Environment Variables
# Copy to .env and configure as needed

# Mode: "demo" (default deterministic offline mode), "openai", or "gemini"
LLM_PROVIDER=demo

# API Keys (Optional - only required if LLM_PROVIDER is "openai" or "gemini")
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model Names
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# RAG & Indexing Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0.10

# SQL Guardrails
SQL_ROW_LIMIT=500
SQL_TIMEOUT_SECONDS=5.0
